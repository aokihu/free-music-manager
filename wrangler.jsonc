{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "freemusic-manager",
  "main": ".open-next/worker.js",
  "routes": [
    {
      "pattern": "manager.tingever.com",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "DEPLOYMENT_PROVIDER": "cloudflare"
  },
  "r2_buckets": [
    {
      "binding": "MUSIC_BUCKET",
      "bucket_name": "freemusic-media"
    }
  ],
  "d1_databases": [
    {
      "binding": "MUSIC_DB",
      "database_name": "freemusic-catalog",
      "migrations_dir": "migrations"
      // 正式部署前使用 `wrangler d1 create` 生成并补充 database_id。
    }
  ],
  "observability": {
    "enabled": true
  }
}
